{
	"extends": "./tsconfig.json",
	"include": ["src/**/*.ts"],
	"exclude": ["src/**/*.test.ts"],
	"compilerOptions": {
		"noEmit": false,
		"emitDeclarationOnly": true,
		"declaration": true,
		"declarationMap": true,
		"rewriteRelativeImportExtensions": true,
		"rootDir": "src",
		"outDir": "dist"
	}
}
