{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://morphir.finos.org/mck/restore-filesystem-assurance/0.1.0-draft.1/protocol.schema.json",
	"title": "Internal restore filesystem assurance preflight request",
	"description": "Source-only preflight, not a public adapter protocol. Provider qualification is a trusted host attestation; structural validation does not verify evidence or qualify a backend.",
	"type": "object",
	"additionalProperties": false,
	"required": ["selection", "provider"],
	"properties": {
		"selection": {
			"$ref": "#/$defs/Selection"
		},
		"provider": {
			"$ref": "#/$defs/Provider"
		}
	},
	"$defs": {
		"Selection": {
			"type": "object",
			"additionalProperties": false,
			"required": ["profile", "profileVersion", "mode"],
			"properties": {
				"profile": {
					"const": "restore-filesystem-assurance"
				},
				"profileVersion": {
					"const": "0.1.0-draft.1"
				},
				"mode": {
					"enum": ["portable", "hardened"]
				}
			}
		},
		"Identity": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "version"],
			"properties": {
				"id": {
					"type": "string",
					"minLength": 1
				},
				"version": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"Platform": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "version"],
			"properties": {
				"name": {
					"type": "string",
					"minLength": 1
				},
				"version": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"Environment": {
			"type": "object",
			"additionalProperties": false,
			"required": ["runtime", "os", "architecture", "filesystem", "assumptions"],
			"properties": {
				"runtime": {
					"$ref": "#/$defs/Platform"
				},
				"os": {
					"$ref": "#/$defs/Platform"
				},
				"architecture": {
					"type": "string",
					"minLength": 1
				},
				"filesystem": {
					"type": "string",
					"minLength": 1
				},
				"assumptions": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string",
						"minLength": 1
					}
				}
			}
		},
		"Qualification": {
			"type": "object",
			"additionalProperties": false,
			"required": ["mode", "environment", "evidence"],
			"properties": {
				"mode": {
					"enum": ["portable", "hardened"]
				},
				"environment": {
					"$ref": "#/$defs/Environment"
				},
				"evidence": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string",
						"minLength": 1
					}
				}
			}
		},
		"Provider": {
			"type": "object",
			"additionalProperties": false,
			"required": ["identity", "qualification"],
			"properties": {
				"identity": {
					"$ref": "#/$defs/Identity"
				},
				"qualification": {
					"oneOf": [
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["kind"],
							"properties": {
								"kind": {
									"const": "unqualified"
								}
							}
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["kind", "entries"],
							"properties": {
								"kind": {
									"const": "qualified"
								},
								"entries": {
									"type": "array",
									"minItems": 1,
									"maxItems": 2,
									"items": {
										"$ref": "#/$defs/Qualification"
									},
									"allOf": [
										{
											"contains": {
												"type": "object",
												"required": ["mode"],
												"properties": {
													"mode": {
														"const": "portable"
													}
												}
											},
											"minContains": 0,
											"maxContains": 1
										},
										{
											"contains": {
												"type": "object",
												"required": ["mode"],
												"properties": {
													"mode": {
														"const": "hardened"
													}
												}
											},
											"minContains": 0,
											"maxContains": 1
										}
									]
								}
							}
						}
					]
				}
			}
		}
	}
}
